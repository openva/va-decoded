<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="18.2" level="1">Crimes and Offenses Generally</unit>
		<unit label="chapter" identifier="12" level="2">Miscellaneous</unit>
		<unit label="article" identifier="1" level="3">Liquefied Petroleum Gas Containers</unit>
	</structure>
	<section_number>18.2-498</section_number>
	<catch_line>Exempt containers</catch_line>
	<text>
		Nothing in this article applies to or shall be construed to affect a liquefied petroleum gas container having a total capacity of five gallons or less.
	</text>
	<history>Code 1950, § 18.1-400.6; 1970, c. 442; 1975, cc. 14, 15.</history>
</law>
