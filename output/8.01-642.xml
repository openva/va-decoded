<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="25" level="2">Extraordinary Writs</unit>
		<unit label="article" identifier="1" level="3">Writ of Quo Warranto</unit>
	</structure>
	<section_number>8.01-642</section_number>
	<catch_line>Pleading when defendant appears</catch_line>
	<text>
		The defendant against whom the writ was issued may plead, demur or answer the petition within the time set forth in the writ for his appearance.
	</text>
	<history>Code 1950, § 8-864; 1977, c. 617.</history>
</law>
