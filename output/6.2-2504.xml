<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="6.2" level="1">Financial Institutions and Services</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Financial Activities</unit>
		<unit label="chapter" identifier="25" level="3">Refund Anticipation Loans</unit>
	</structure>
	<section_number>6.2-2504</section_number>
	<catch_line>Preemption of local laws</catch_line>
	<text>
		This chapter shall preempt and be exclusive of all ordinances of any locality relating to refund anticipation loans. This section shall be given retroactive and prospective effect.
	</text>
	<history>2006, c. 399, § 6.1-478; 2010, c. 794.</history>
</law>
