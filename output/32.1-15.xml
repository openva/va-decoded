<law>
	<structure>
		<unit label="title" identifier="32.1" level="1">Health</unit>
		<unit label="chapter" identifier="1" level="2">Administration Generally</unit>
		<unit label="article" identifier="2" level="3">State Board of Health</unit>
	</structure>
	<section_number>32.1-15</section_number>
	<catch_line>Suggestions as to legislation</catch_line>
	<text>
		The Board may, at each regular session of the General Assembly, suggest any legislative action deemed necessary for the better protection of life and public health.
	</text>
	<history>Code 1950, § 32-21; 1979, c. 711.</history>
</law>
