	<section_number>1-224</section_number>
	<catch_line>Municipality; incorporated communities; municipal corporation</catch_line>
	<text>
		"Municipality," "incorporated communities," "municipal corporation," and words or terms of similar import mean cities and towns.
	</text>
	<history>2005, c. 839.</history>
