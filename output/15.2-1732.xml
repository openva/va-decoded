<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="II" level="2">Powers of Local Government</unit>
		<unit label="chapter" identifier="17" level="3">Police and Public Order</unit>
		<unit label="article" identifier="3" level="4">Auxiliary Police Forces in Localities</unit>
	</structure>
	<section_number>15.2-1732</section_number>
	<catch_line>Appropriations for equipment and maintenance</catch_line>
	<text>
		Localities may make such appropriations as may be necessary to arm, equip, uniform and maintain such auxiliary police force.
	</text>
	<history>1968, c. 157, § 15.1-159.3; 1997, c. 587.</history>
</law>
