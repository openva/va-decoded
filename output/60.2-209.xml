<law>
	<structure>
		<unit label="title" identifier="60.2" level="1">Unemployment Compensation</unit>
		<unit label="chapter" identifier="2" level="2">Definitions</unit>
	</structure>
	<section_number>60.2-209</section_number>
	<catch_line>Taxes</catch_line>
	<text>
		"Taxes" means the money imposed by and collectible under this title and includes payments in lieu of taxes collectible under §§ 60.2-501 through 60.2-507.
	</text>
	<history>Code 1950, § 60-11; 1968, c. 738, § 60.1-11; 1971, Ex. Sess., c. 235; 1986, c. 480.</history>
</law>
