<law>
	<structure>
		<unit label="title" identifier="63.2" level="1">Welfare (Social Services)</unit>
		<unit label="subtitle" identifier="III" level="2">Social Services Programs</unit>
		<unit label="chapter" identifier="16" level="3">Adult Services</unit>
		<unit label="article" identifier="3" level="4">Domestic Violence Prevention Services</unit>
	</structure>
	<section_number>63.2-1613</section_number>
	<catch_line>Responsibilities of local departments</catch_line>
	<text>
		Local departments may, to the extent that funds are available:
		<section prefix="1">Promote interagency cooperation at the local level for technical assistance, data collection and service delivery; and
		</section>
		<section prefix="2">Provide services directly to victims of domestic violence.
		</section>
	</text>
	<history>1985, c. 20, § 63.1-317.1; 2002, c. 747.</history>
</law>
