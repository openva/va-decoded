<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="53" level="3">Hospital Authorities</unit>
		<unit label="article" identifier="3" level="4">Bonds</unit>
	</structure>
	<section_number>15.2-5348</section_number>
	<catch_line>Commissioners not liable</catch_line>
	<text>
		Neither the commissioners of the authority nor any person executing the bonds shall be liable personally on the bonds by reason of the issuance thereof.
	</text>
	<history>Code 1950, § 32-263; 1979, c. 719, § 15.1-1583; 1997, c. 587.</history>
</law>
