<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="12" level="2">Virginia Limited Liability Company Act</unit>
		<unit label="article" identifier="10" level="3">Foreign Limited Liability Companies</unit>
	</structure>
	<section_number>13.1-1058</section_number>
	<catch_line>Actions by Attorney General</catch_line>
	<text>
		The Attorney General may bring an action to restrain a foreign limited liability company from transacting business in this Commonwealth in violation of this article.
	</text>
	<history>1991, c. 168.</history>
</law>
