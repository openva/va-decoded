<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="II" level="2">Powers of Local Government</unit>
		<unit label="chapter" identifier="17" level="3">Police and Public Order</unit>
		<unit label="article" identifier="5" level="4">Criminal Justice Training Academies</unit>
	</structure>
	<section_number>15.2-1753</section_number>
	<catch_line>Liability of board members</catch_line>
	<text>
		No member of the board of directors of an academy shall be personally liable for any indebtedness, obligation or other liability of an academy, barring willful misconduct.
	</text>
	<history>1993, c. 935, § 15.1-159.7:7; 1997, c. 587.</history>
</law>
