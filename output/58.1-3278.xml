<law>
	<structure>
		<unit label="title" identifier="58.1" level="1">Taxation</unit>
		<unit label="subtitle" identifier="III" level="2">Local Taxes</unit>
		<unit label="chapter" identifier="32" level="3">Real Property Tax</unit>
		<unit label="article" identifier="6" level="4">Who Performs Reassessment/Assessment</unit>
	</structure>
	<section_number>58.1-3278</section_number>
	<catch_line>Department to render assistance</catch_line>
	<text>
		The Department, upon the request of the governing body of any county, city or town, shall render advisory aid and assistance in making any general reassessment of the real estate in such county, city or town.
	</text>
	<history>Code 1950, § 58-794; 1956, c. 219; 1984, c. 675.</history>
</law>
