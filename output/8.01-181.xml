<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Actions</unit>
		<unit label="article" identifier="16" level="3">Establishing Boundaries to Land</unit>
	</structure>
	<section_number>8.01-181</section_number>
	<catch_line>Surveys</catch_line>
	<text>
		The court may appoint a surveyor and direct such surveys to be made as it deems necessary, and the costs thereof shall be assessed as the court may direct.
	</text>
	<history>Code 1950, § 8-838; 1954, c. 606; 1977, c. 617.</history>
</law>
