<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="8" level="2">Service of Process</unit>
		<unit label="article" identifier="3" level="3">Unlicensed Public Adjusters</unit>
	</structure>
	<section_number>38.2-815</section_number>
	<catch_line>Other legal service not limited</catch_line>
	<text>
		Nothing in this article shall limit the right to serve any process or notice upon any unlicensed public adjuster in any other manner permitted by law.
	</text>
	<history>2012, cc. 734, 735.</history>
</law>
