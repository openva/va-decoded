<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="3" level="2">Cooperative Associations</unit>
		<unit label="article" identifier="1" level="3">Cooperative Associations Generally</unit>
	</structure>
	<section_number>13.1-302</section_number>
	<catch_line>Limitation of individual stockholding</catch_line>
	<text>
		No holder of common stock in any stock cooperative association shall own shares of a greater par value than $1,000, except as hereinafter provided, or be entitled to more than one vote.
	</text>
	<history>Code 1950, § 13-239; 1956, c. 428; 1994, c. 217.</history>
</law>
