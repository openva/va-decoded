<law>
	<structure>
		<unit label="title" identifier="18.2" level="1">Crimes and Offenses Generally</unit>
		<unit label="chapter" identifier="7" level="2">Crimes Involving Health and Safety</unit>
		<unit label="article" identifier="5" level="3">Uniform Machine Gun Act</unit>
	</structure>
	<section_number>18.2-290</section_number>
	<catch_line>Use of machine gun for aggressive purpose</catch_line>
	<text>
		Unlawful possession or use of a machine gun for an offensive or aggressive purpose is hereby declared to be a Class 4 felony.
	</text>
	<history>Code 1950, § 18.1-260; 1960, c. 358; 1968, c. 229; 1975, cc. 14, 15.</history>
</law>
