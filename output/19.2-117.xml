<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="8" level="2">Extradition of Criminals</unit>
		<unit label="article" identifier="2" level="3">Uniform Criminal Extradition Act</unit>
	</structure>
	<section_number>19.2-117</section_number>
	<catch_line>Interpretation of article</catch_line>
	<text>
		The provisions of this article shall be so interpreted and construed as to effectuate its general purposes to make uniform the law of those states which enact statutes similar thereto.
	</text>
	<history>Code 1950, § 19.1-81; 1960, c. 366; 1975, c. 495.</history>
</law>
