<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="56" level="3">Public Recreational Facilities Authorities Act</unit>
	</structure>
	<section_number>15.2-5611</section_number>
	<catch_line>Moneys received deemed trust funds</catch_line>
	<text>
		All moneys received pursuant to the provisions of this chapter, whether as proceeds from the sale of bonds or as revenues, shall be deemed to be trust funds to be held and applied solely as provided in this chapter.
	</text>
	<history>Code 1950, § 15-714.24; 1962, c. 393, § 12, § 15.1-1282; 1997, c. 587.</history>
</law>
