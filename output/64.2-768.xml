<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="III" level="2">Trusts</unit>
		<unit label="chapter" identifier="7" level="3">Uniform Trust Code</unit>
		<unit label="article" identifier="8" level="4">Duties and Powers of Trustee</unit>
	</structure>
	<section_number>64.2-768</section_number>
	<catch_line>Trustee's skills</catch_line>
	<text>
		A trustee who has special skills or expertise, or is named trustee in reliance upon the trustee's representation that the trustee has special skills or expertise, shall use those special skills or expertise.
	</text>
	<history>2005, c. 935, § 55-548.06; 2012, c. 614.</history>
</law>
