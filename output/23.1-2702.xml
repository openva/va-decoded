<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="23.1" level="1">Institutions of Higher Education; Other Educational and Cultural Institutions</unit>
		<unit label="subtitle" identifier="IV" level="2">Public Institutions of Higher Education</unit>
		<unit label="chapter" identifier="27" level="3">Virginia State University</unit>
	</structure>
	<section_number>23.1-2702</section_number>
	<catch_line>Powers and duties</catch_line>
	<text>
		<section prefix="A">The board shall appoint all professors, teachers, and agents and fix their salaries and generally direct the affairs of the University.
		</section>
		<section prefix="B">The board may confer degrees.
		</section>
	</text>
	<history>1964, c. 70, §§ 23-165.6, 23-165.8; 1979, c. 147; 2016, c. 588; 2017, c. 314.</history>
</law>
