<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="52" level="2">Humane Cosmetics Act</unit>
	</structure>
	<section_number>59.1-574</section_number>
	<catch_line>Local regulation prohibited unless identical</catch_line>
	<text>
		No locality may establish or continue any regulation relating to cosmetic animal testing that is not identical to the provisions set forth in this chapter.
	</text>
	<history>2021, Sp. Sess. I, cc. 113, 114.</history>
</law>
