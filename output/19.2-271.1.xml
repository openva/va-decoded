<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="16" level="2">Evidence and Witnesses</unit>
		<unit label="article" identifier="1" level="3">In General</unit>
	</structure>
	<section_number>19.2-271.1</section_number>
	<catch_line>Competency of spouses to testify</catch_line>
	<text>
		Persons married to each other shall be competent witnesses to testify for or against each other in criminal cases, except as otherwise provided.
	</text>
	<history>Code 1950, § 8-287; 1977, c. 624; 2020, c. 900.</history>
</law>
