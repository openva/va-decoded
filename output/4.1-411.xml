<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="4.1" level="1">Alcoholic Beverage and Cannabis Control</unit>
		<unit label="subtitle" identifier="I" level="2">Alcoholic Beverage Control Act</unit>
		<unit label="chapter" identifier="4" level="3">Wine Franchise Act</unit>
	</structure>
	<section_number>4.1-411</section_number>
	<catch_line>Price of product</catch_line>
	<text>
		No winery, whether by means of a term or condition of an agreement or otherwise, shall fix or maintain the prices at which the wholesaler shall sell any wine.
	</text>
	<history>Code 1950, § 4-118.32; 1985, c. 542, § 4-118.52; 1989, c. 10; 1993, c. 866.</history>
</law>
