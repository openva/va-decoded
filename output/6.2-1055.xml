<law>
	<structure>
		<unit label="title" identifier="6.2" level="1">Financial Institutions and Services</unit>
		<unit label="subtitle" identifier="II" level="2">Depository Institutions and Trust Organizations</unit>
		<unit label="chapter" identifier="10" level="3">Entities Conducting Trust Business</unit>
		<unit label="article" identifier="3" level="4">Trust Subsidiaries</unit>
	</structure>
	<section_number>6.2-1055</section_number>
	<catch_line>Trust offices</catch_line>
	<text>
		A trust subsidiary may have trust offices at locations where branches are permitted under § 6.2-831, upon approval of the Commission.
	</text>
	<history>1974, c. 286, § 6.1-32.6; 1987, c. 352; 2010, c. 794.</history>
