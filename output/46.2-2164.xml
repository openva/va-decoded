<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="21" level="3">Regulation of Property Carriers</unit>
		<unit label="article" identifier="4" level="4">Household Goods Carriers</unit>
	</structure>
	<section_number>46.2-2164</section_number>
	<catch_line>Constructive weight</catch_line>
	<text>
		If no certified scale is available at origin, at any point enroute, or at destination, a constructive weight based upon seven pounds per cubic foot of properly loaded van space may be used.
	</text>
	<history>2001, c. 596.</history>
</law>
