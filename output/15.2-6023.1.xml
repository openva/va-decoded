<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="60.1" level="3">Southwest Regional Recreation Authority</unit>
	</structure>
	<section_number>15.2-6023.1</section_number>
	<catch_line>Additional civil penalties</catch_line>
	<text>
		Any locality within the Southwest Regional Recreation Area may, by ordinance, allocate to the Authority a specified portion of civil penalties paid for violations of ordinances.
	</text>
	<history>2010, c. 798.</history>
</law>
