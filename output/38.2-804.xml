<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="8" level="2">Service of Process</unit>
		<unit label="article" identifier="1" level="3">Unlicensed Insurers Process</unit>
	</structure>
	<section_number>38.2-804</section_number>
	<catch_line>Other legal service not limited</catch_line>
	<text>
		Nothing in this article shall limit the right to serve any process or notice upon any licensed insurer in any other manner permitted by law.
	</text>
	<history>1952, c. 317, § 38.1-67; 1986, c. 562.</history>
</law>
