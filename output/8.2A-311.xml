<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.2A" level="1">Commercial Code — Leases</unit>
		<unit label="part" identifier="3" level="2">Effect of Lease Contract</unit>
	</structure>
	<section_number>8.2A-311</section_number>
	<catch_line>Priority subject to subordination</catch_line>
	<text>
		Nothing in this title prevents subordination by agreement by any person entitled to priority.
	</text>
	<history>1991, c. 536.</history>
</law>
