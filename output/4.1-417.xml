<law>
	<structure>
		<unit label="title" identifier="4.1" level="1">Alcoholic Beverage and Cannabis Control</unit>
		<unit label="subtitle" identifier="I" level="2">Alcoholic Beverage Control Act</unit>
		<unit label="chapter" identifier="4" level="3">Wine Franchise Act</unit>
	</structure>
	<section_number>4.1-417</section_number>
	<catch_line>Right of free association</catch_line>
	<text>
		No winery or wholesaler shall restrict or inhibit the right of free association among wineries or wholesalers for any lawful purpose.
	</text>
	<history>Code 1950, § 4-118.39; 1985, c. 542, § 4-118.59; 1989, c. 10; 1993, c. 866.</history>
</law>
