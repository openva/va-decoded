<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="25" level="2">Extraordinary Writs</unit>
		<unit label="article" identifier="2" level="3">Mandamus and Prohibition</unit>
	</structure>
	<section_number>8.01-648</section_number>
	<catch_line>What judgment to be rendered</catch_line>
	<text>
		The court shall award or deny the writ according to the law and facts of the case, with or without costs.
	</text>
	<history>Code 1950, § 8-709; 1977, c. 617.</history>
</law>
