<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="21" level="2">Arbitration and Award</unit>
		<unit label="article" identifier="2" level="3">Uniform Arbitration Act</unit>
	</structure>
	<section_number>8.01-581.014</section_number>
	<catch_line>Court; jurisdiction</catch_line>
	<text>
		The term "court" means a circuit court or general district court of the Commonwealth having jurisdiction over the subject matter of the controversy.
	</text>
	<history>1986, c. 614; 1995, c. 342; 2016, c. 181.</history>
</law>
