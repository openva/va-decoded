<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="44" level="1">Military and Emergency Laws</unit>
		<unit label="chapter" identifier="1" level="2">Military Laws of Virginia</unit>
		<unit label="article" identifier="3" level="3">National Guard in General</unit>
	</structure>
	<section_number>44-39</section_number>
	<catch_line>Uniforms, arms and equipment</catch_line>
	<text>
		The National Guard shall, as far as practicable, be uniformed, armed, and equipped with the same type of uniform, arms, and equipment as are or shall be provided for the armed forces of the United States.
	</text>
	<history>1930, p. 955; Michie Code 1942, § 2673(29); 1958, c. 393.</history>
</law>
