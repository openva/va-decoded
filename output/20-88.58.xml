<law>
	<structure>
		<unit label="title" identifier="20" level="1">Domestic Relations</unit>
		<unit label="chapter" identifier="5.3" level="2">Uniform Interstate Family Support Act</unit>
		<unit label="article" identifier="5" level="3">Civil Provisions of General Application</unit>
	</structure>
	<section_number>20-88.58</section_number>
	<catch_line>Nonparentage as defense</catch_line>
	<text>
		A party whose parentage of a child has been previously determined by or pursuant to law may not plead nonparentage as a defense to a proceeding under this chapter.
	</text>
	<history>1994, c. 673.</history>
</law>
