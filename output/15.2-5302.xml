<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="53" level="3">Hospital Authorities</unit>
		<unit label="article" identifier="1" level="4">In General</unit>
	</structure>
	<section_number>15.2-5302</section_number>
	<catch_line>Creation of hospital authorities</catch_line>
	<text>
		In each city there shall be a political subdivision of the Commonwealth, with such public and corporate powers as are set forth in this chapter, to be known as the "hospital authority" of the city.
	</text>
	<history>Code 1950, § 32-215; 1979, c. 719, § 15.1-1535; 1997, c. 587.</history>
</law>
