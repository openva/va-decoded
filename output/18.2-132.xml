<law>
	<structure>
		<unit label="title" identifier="18.2" level="1">Crimes and Offenses Generally</unit>
		<unit label="chapter" identifier="5" level="2">Crimes Against Property</unit>
		<unit label="article" identifier="5" level="3">Trespass to Realty</unit>
	</structure>
	<section_number>18.2-132</section_number>
	<catch_line>Trespass by hunters and fishers</catch_line>
	<text>
		Any person who goes on the lands, waters, ponds, boats or blinds of another to hunt, fish or trap without the consent of the landowner or his agent shall be deemed guilty of a Class 3 misdemeanor.
	</text>
	<history>Code 1950, § 29-165; 1954, c. 155; 1962, c. 469; 1975, cc. 14, 15.</history>
</law>
