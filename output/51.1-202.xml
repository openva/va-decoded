<law>
	<structure>
		<unit label="title" identifier="51.1" level="1">Pensions, Benefits, and Retirement</unit>
		<unit label="chapter" identifier="2" level="2">State Police Officers' Retirement System</unit>
	</structure>
	<section_number>51.1-202</section_number>
	<catch_line>Membership in retirement system</catch_line>
	<text>
		Membership in the retirement system shall be compulsory for all state police officers.
	</text>
	<history>Code 1950, §§ 51-130, 51-136.2, § 51-145; 1950, p. 883; 1954, c. 139; 1966, c. 628; 1990, c. 832.</history>
</law>
