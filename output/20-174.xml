<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="20" level="1">Domestic Relations</unit>
		<unit label="chapter" identifier="11" level="2">Uniform Collaborative Law Act</unit>
	</structure>
	<section_number>20-174</section_number>
	<catch_line>Affirmation of agreement by tribunal</catch_line>
	<text>
		A tribunal may affirm, ratify, and incorporate into a court order any agreement resulting from a collaborative law process.
	</text>
	<history>2021, Sp. Sess. I, c. 346.</history>
</law>
