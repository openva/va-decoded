<law>
	<structure>
		<unit label="title" identifier="2.2" level="1">Administration of Government</unit>
		<unit label="subtitle" identifier="II" level="2">Administration of State Government</unit>
		<unit label="part" identifier="B" level="3">Transaction of Public Business</unit>
		<unit label="chapter" identifier="43" level="4">Virginia Public Procurement Act</unit>
		<unit label="article" identifier="6" level="5">Ethics in Public Contracting</unit>
	</structure>
	<section_number>2.2-4377</section_number>
	<catch_line>Penalty for violation</catch_line>
	<text>
		Any person convicted of a willful violation of any provision of this article shall be guilty of a Class 1 misdemeanor. Upon conviction, any public employee, in addition to any other fine or penalty provided by law, shall forfeit his employment.
	</text>
	<history>1982, c. 647, § 11-80; 2001, c. 844.</history>
