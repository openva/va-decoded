<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="54.1" level="1">Professions and Occupations</unit>
		<unit label="subtitle" identifier="IV" level="2">Professions Regulated by the Supreme Court</unit>
		<unit label="chapter" identifier="39" level="3">Attorneys</unit>
		<unit label="article" identifier="7" level="4">Solicitation of Professional Employment</unit>
	</structure>
	<section_number>54.1-3942</section_number>
	<catch_line>Validity of contract</catch_line>
	<text>
		Any contract for professional employment secured by an attorney in violation of this article shall be void and unenforceable.
	</text>
	<history>Code 1950, § 54-83; 1964, c. 622, § 54-83.1:4; 1988, c. 765.</history>
</law>
