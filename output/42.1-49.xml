<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="42.1" level="1">Libraries</unit>
		<unit label="chapter" identifier="3" level="2">State and Federal Aid</unit>
	</structure>
	<section_number>42.1-49</section_number>
	<catch_line>Grants to municipal libraries</catch_line>
	<text>
		Every qualifying municipal library serving an area containing less than 5,000 population shall receive its proper share, but not less than $400.
	</text>
	<history>1970, c. 606.</history>
</law>
