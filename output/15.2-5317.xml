<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="53" level="3">Hospital Authorities</unit>
		<unit label="article" identifier="1" level="4">In General</unit>
	</structure>
	<section_number>15.2-5317</section_number>
	<catch_line>Planning and zoning laws</catch_line>
	<text>
		All hospital projects of an authority shall be subject to the planning and zoning laws, ordinances and regulations applicable to the locality in which the hospital project is situated.
	</text>
	<history>Code 1950, § 32-231; 1979, c. 719, § 15.1-1550; 1997, c. 587.</history>
</law>
