	<section_number>15.2-1225</section_number>
	<catch_line>Authority to establish hospitals</catch_line>
	<text>
		The governing body of any county may establish and operate hospitals in such county.
	</text>
	<history>1979, c. 719, § 15.1-526.3; 1997, c. 587.</history>
