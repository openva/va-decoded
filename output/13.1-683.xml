<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="9" level="2">Virginia Stock Corporation Act</unit>
		<unit label="article" identifier="9" level="3">Directors and Officers</unit>
	</structure>
	<section_number>13.1-683</section_number>
	<catch_line>Compensation of directors</catch_line>
	<text>
		Unless the articles of incorporation or bylaws provide otherwise, the board of directors may fix the compensation of directors.
	</text>
	<history>Code 1950, § 13.1-35; 1956, c. 428; 1985, c. 522.</history>
</law>
