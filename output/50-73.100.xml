<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="50" level="1">Partnerships</unit>
		<unit label="chapter" identifier="2.2" level="2">Virginia Uniform Partnership Act</unit>
		<unit label="article" identifier="4" level="3">Relations of Partners to Each Other and to Partnership</unit>
	</structure>
	<section_number>50-73.100</section_number>
	<catch_line>Distributions in kind</catch_line>
	<text>
		A partner has no right to receive, and may not be required to accept, a distribution in kind.
	</text>
	<history>1996, c. 292.</history>
</law>
