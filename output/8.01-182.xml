<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Actions</unit>
		<unit label="article" identifier="16" level="3">Establishing Boundaries to Land</unit>
	</structure>
	<section_number>8.01-182</section_number>
	<catch_line>Claims to rents, etc., not considered</catch_line>
	<text>
		In a proceeding under this article, no claim of the plaintiff for rents, profits or damages shall be considered.
	</text>
	<history>Code 1950, § 8-839; 1977, c. 617.</history>
</law>
