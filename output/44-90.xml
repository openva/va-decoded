<law>
	<structure>
		<unit label="title" identifier="44" level="1">Military and Emergency Laws</unit>
		<unit label="chapter" identifier="1" level="2">Military Laws of Virginia</unit>
		<unit label="article" identifier="8" level="3">Unorganized Militia</unit>
	</structure>
	<section_number>44-90</section_number>
	<catch_line>Punishment for failure to appear</catch_line>
	<text>
		Every member of the militia ordered out for duty, or who shall volunteer or be drafted, who does not appear at the time and place ordered, shall be liable to such punishment as a court-martial may direct.
	</text>
	<history>1930, p. 965; Michie Code 1942, § 2673(75); 1958, c. 393.</history>
</law>
