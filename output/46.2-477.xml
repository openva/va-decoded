<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="II" level="2">Titling, Registration and Licensure</unit>
		<unit label="chapter" identifier="3" level="3">Licensure of Drivers</unit>
		<unit label="article" identifier="17" level="4">Motor Vehicle Liability Insurance Policies</unit>
	</structure>
	<section_number>46.2-477</section_number>
	<catch_line>When chapter applicable to policy</catch_line>
	<text>
		This chapter shall not apply to any policy of insurance except as to liability thereunder incurred after certification thereof as proof of financial responsibility.
	</text>
	<history>Code 1950, § 46-496.1; 1958, c. 541, § 46.1-509; 1989, c. 727.</history>
