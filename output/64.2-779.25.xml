<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="III" level="2">Trusts</unit>
		<unit label="chapter" identifier="7" level="3">Uniform Trust Code</unit>
		<unit label="article" identifier="8.1" level="4">Uniform Trust Decanting Act</unit>
	</structure>
	<section_number>64.2-779.25</section_number>
	<catch_line>Accountings</catch_line>
	<text>
		If accounts for the first trust are filed with the commissioner of accounts, the accounts for the second trust shall be filed with the commissioner of accounts unless the court orders otherwise.
	</text>
	<history>2017, c. 592.</history>
</law>
