<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="III" level="2">Trusts</unit>
		<unit label="chapter" identifier="7" level="3">Uniform Trust Code</unit>
		<unit label="article" identifier="8" level="4">Duties and Powers of Trustee</unit>
	</structure>
	<section_number>64.2-765</section_number>
	<catch_line>Impartiality</catch_line>
	<text>
		If a trust has two or more beneficiaries, the trustee shall act impartially in investing, managing, and distributing the trust property, giving due regard to the beneficiaries' respective interests.
	</text>
	<history>2005, c. 935, § 55-548.03; 2012, c. 614.</history>
</law>
