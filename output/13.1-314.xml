<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="3" level="2">Cooperative Associations</unit>
		<unit label="article" identifier="2" level="3">Agricultural Cooperative Associations</unit>
	</structure>
	<section_number>13.1-314</section_number>
	<catch_line>Qualification of incorporators</catch_line>
	<text>
		Five or more individuals, engaged in agriculture as bona fide producers of agricultural products, or two or more associations of such producers, may form an association.
	</text>
	<history>1956, c. 428.</history>
</law>
