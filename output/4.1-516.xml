<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="4.1" level="1">Alcoholic Beverage and Cannabis Control</unit>
		<unit label="subtitle" identifier="I" level="2">Alcoholic Beverage Control Act</unit>
		<unit label="chapter" identifier="5" level="3">Beer Franchise Act</unit>
	</structure>
	<section_number>4.1-516</section_number>
	<catch_line>Right of free association</catch_line>
	<text>
		No brewery or wholesaler shall restrict or inhibit the right of free association among breweries or wholesalers for any lawful purpose.
	</text>
	<history>1978, c. 579, § 4-118.19; 1993, c. 866.</history>
</law>
