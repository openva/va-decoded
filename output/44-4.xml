<law>
	<structure>
		<unit label="title" identifier="44" level="1">Military and Emergency Laws</unit>
		<unit label="chapter" identifier="1" level="2">Military Laws of Virginia</unit>
		<unit label="article" identifier="1" level="3">Classification of Militia</unit>
	</structure>
	<section_number>44-4</section_number>
	<catch_line>Composition of unorganized militia</catch_line>
	<text>
		The unorganized militia shall consist of all able-bodied persons as set out in § 44-1, except such as may be included in §§ 44-2 and 44-54.6 and except such as may be exempted as hereinafter provided.
	</text>
	<history>1930, p. 949; Michie Code 1942, § 2673(4); 1970, c. 662; 1973, c. 401; 1984, c. 765; 2015, c. 221.</history>
</law>
