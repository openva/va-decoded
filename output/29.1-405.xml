<law>
	<structure>
		<unit label="title" identifier="29.1" level="1">Wildlife, Inland Fisheries and Boating</unit>
		<unit label="chapter" identifier="4" level="2">Permits Required</unit>
		<unit label="article" identifier="1" level="3">Dealing in Furs</unit>
