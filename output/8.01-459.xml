<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="17" level="2">Judgments and Decrees Generally</unit>
		<unit label="article" identifier="7" level="3">Lien and Enforcement Thereof</unit>
	</structure>
	<section_number>8.01-459</section_number>
	<catch_line>Priority of judgments</catch_line>
	<text>
		Judgments against the same person shall, as among themselves, attach to his real estate, and be payable thereout in the order of the priority of the lien of such judgments, respectively.
	</text>
	<history>Code 1950, § 8-387; 1977, c. 617.</history>
</law>
