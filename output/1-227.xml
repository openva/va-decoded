<law>
	<structure>
		<unit label="title" identifier="1" level="1">General Provisions</unit>
		<unit label="chapter" identifier="2.1" level="2">Common Law and Rules of Construction</unit>
		<unit label="article" identifier="2" level="3">Rules of Construction and Definitions</unit>
