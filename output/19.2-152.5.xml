<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="9" level="2">Bail and Recognizances</unit>
		<unit label="article" identifier="5" level="3">Pretrial Services Act</unit>
	</structure>
	<section_number>19.2-152.5</section_number>
	<catch_line>Community criminal justice boards</catch_line>
	<text>
		Each city, county or combination thereof establishing a pretrial services agency shall also establish a community criminal justice board pursuant to § 9.1-178.
	</text>
	<history>1994, 2nd Sp. Sess., cc. 1, 2; 2007, c. 133.</history>
</law>
