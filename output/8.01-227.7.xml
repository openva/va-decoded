<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Actions</unit>
		<unit label="article" identifier="23" level="3">Drug Dealer Liability Act</unit>
	</structure>
	<section_number>8.01-227.7</section_number>
	<catch_line>Statute of limitations</catch_line>
	<text>
		Every action brought pursuant to this article shall be commenced no later than two years after the child's eighteenth birthday.
	</text>
	<history>2002, c. 863.</history>
