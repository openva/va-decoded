<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="55.1" level="1">Property and Conveyances</unit>
		<unit label="subtitle" identifier="I" level="2">Property Conveyances</unit>
		<unit label="chapter" identifier="1" level="3">Creation and Limitation of Estates</unit>
		<unit label="article" identifier="1" level="4">Creation and Transfer of Estates</unit>
	</structure>
	<section_number>55.1-115</section_number>
	<catch_line>When remainders not defeated</catch_line>
	<text>
		The alienation of a particular estate on which a remainder depends, or the union of such estate with the inheritance by purchase or descent, shall not operate, by merger or otherwise, to defeat, impair, or otherwise affect such remainder.
	</text>
	<history>Code 1919, § 5154; Code 1950, § 55-16; 2019, c. 712.</history>
</law>
