<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="18" level="2">Insurance Agents</unit>
		<unit label="article" identifier="1" level="3">Definitions and General Provisions</unit>
	</structure>
	<section_number>38.2-1804</section_number>
	<catch_line>Blank forms</catch_line>
	<text>
		No agent shall sign or allow an applicant or insured to sign any incomplete or blank form pertaining to insurance in this Commonwealth.
	</text>
	<history>Code 1950, § 38.1-288; 1952, c. 317; 1979, c. 513, § 38.1-327.5; 1986, c. 562; 2001, c. 706.</history>
</law>
