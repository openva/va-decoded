<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Magistrates</unit>
		<unit label="article" identifier="3" level="3">The Magistrate System</unit>
	</structure>
	<section_number>19.2-33</section_number>
	<catch_line>Office of magistrate</catch_line>
	<text>
		The office of magistrate shall be vested with all the authority, duties and obligations previously vested in the office of justice of the peace prior to January 1, 1974.
	</text>
	<history>Code 1950, § 19.1-381; 1973, c. 545; 1975, c. 495.</history>
</law>
