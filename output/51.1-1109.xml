<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="51.1" level="1">Pensions, Benefits, and Retirement</unit>
		<unit label="chapter" identifier="11" level="2">Sickness and Disability Program</unit>
		<unit label="article" identifier="3" level="3">Nonwork Related Disability Benefits</unit>
	</structure>
	<section_number>51.1-1109</section_number>
	<catch_line>Applicability of article</catch_line>
	<text>
		The provisions of this article shall apply only with respect to the disability programs providing disability benefits for disabilities not resulting from work-related injuries.
	</text>
	<history>1998, c. 774.</history>
</law>
