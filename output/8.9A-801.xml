<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.9A" level="1">Commercial Code — Secured Transactions</unit>
		<unit label="part" identifier="8" level="2">Transition Provisions for 2013 Amendments</unit>
	</structure>
	<section_number>8.9A-801</section_number>
	<catch_line>Effective date of amendments</catch_line>
	<text>
		<section prefix="a">In this part, "2013 amendments" means the amendments to this title that are enacted by the act of the 2012 Session of the General Assembly that enacted this Part 8.
		</section>
		<section prefix="b">The 2013 amendments are effective July 1, 2013.
		</section>
	</text>
	<history>2012, c. 155.</history>
</law>
