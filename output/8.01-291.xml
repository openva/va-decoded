<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="8" level="2">Process</unit>
		<unit label="article" identifier="2" level="3">How Process Is Issued</unit>
	</structure>
	<section_number>8.01-291</section_number>
	<catch_line>Copies to be made</catch_line>
	<text>
		The clerk issuing any such process unless otherwise directed shall deliver or transmit therewith as many copies thereof as there are persons named therein on whom it is to be served.
	</text>
	<history>Code 1950, § 8-57; 1977, c. 617.</history>
</law>
