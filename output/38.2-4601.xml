<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="46" level="2">Title Insurance</unit>
	</structure>
	<section_number>38.2-4601</section_number>
	<catch_line>Title insurance company defined</catch_line>
	<text>
		"Title insurance company" means any company licensed to transact, or transacting, title insurance.
	</text>
	<history>1952, c. 317, § 38.1-721; 1986, c. 562.</history>
</law>
