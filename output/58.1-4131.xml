<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="58.1" level="1">Taxation</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Sources of State Revenue</unit>
		<unit label="chapter" identifier="41" level="3">Casino Gaming</unit>
		<unit label="article" identifier="11" level="4">On-premises Mobile Casino Gaming</unit>
	</structure>
	<section_number>58.1-4131</section_number>
	<catch_line>Federal law applicable</catch_line>
	<text>
		On-premises mobile casino gaming shall be subject to the provisions of, and preempted and superseded by, any applicable federal law.
	</text>
	<history>2020, cc. 1197, 1248.</history>
</law>
