<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="53" level="3">Hospital Authorities</unit>
		<unit label="article" identifier="2" level="4">Powers</unit>
	</structure>
	<section_number>15.2-5331</section_number>
	<catch_line>Donations</catch_line>
	<text>
		An authority shall have power to accept donations of money, personal property or real estate for the benefit of the authority and take title thereto from any person desiring to make such donations.
	</text>
	<history>Code 1950, § 32-244; 1979, c. 719, § 15.1-1565; 1997, c. 587.</history>
</law>
