<law>
	<structure>
		<unit label="title" identifier="60.2" level="1">Unemployment Compensation</unit>
		<unit label="chapter" identifier="6" level="2">Benefits</unit>
		<unit label="article" identifier="2" level="3">Benefit Computation</unit>
