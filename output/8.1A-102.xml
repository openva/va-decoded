<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.1A" level="1">Uniform Commercial Code — General Provisions</unit>
		<unit label="part" identifier="1" level="2">General Provisions</unit>
	</structure>
	<section_number>8.1A-102</section_number>
	<catch_line>Scope of title</catch_line>
	<text>
		This title applies to a transaction to the extent that it is governed by another title of the Uniform Commercial Code.
	</text>
	<history>2003, c. 353.</history>
</law>
