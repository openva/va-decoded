<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="40.1" level="1">Labor and Employment</unit>
		<unit label="chapter" identifier="3" level="2">Protection of Employees</unit>
		<unit label="article" identifier="1.1" level="3">Virginia Minimum Wage Act</unit>
	</structure>
	<section_number>40.1-28.11</section_number>
	<catch_line>Penalties</catch_line>
	<text>
		Whoever knowingly and intentionally violates any provisions of this article shall be punished by a fine of not less than $10 nor more than $200.
	</text>
	<history>1975, c. 530.</history>
