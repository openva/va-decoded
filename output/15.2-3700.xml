<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="III" level="2">Boundary Adjustments and Changes of Status of Counties, Cities and Towns</unit>
		<unit label="chapter" identifier="37" level="3">Annulment of Town Charters</unit>
	</structure>
	<section_number>15.2-3700</section_number>
	<catch_line>Towns may annul charters</catch_line>
	<text>
		A town may annul its charter in accordance with the provisions of this chapter.
	</text>
	<history>1992, c. 453, § 15.1-965.28; 1997, c. 587.</history>
