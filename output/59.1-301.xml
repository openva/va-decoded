<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="24" level="2">Virginia Health Club Act</unit>
	</structure>
	<section_number>59.1-301</section_number>
	<catch_line>Noncomplying contract voidable</catch_line>
	<text>
		Any health club contract that does not comply with the applicable provisions of this chapter shall be voidable at the option of the buyer.
	</text>
	<history>1984, c. 738; 2014, c. 459.</history>
</law>
