		<unit label="title" identifier="20" level="1">Domestic Relations</unit>
		<unit label="chapter" identifier="5.3" level="2">Uniform Interstate Family Support Act</unit>
		<unit label="article" identifier="5" level="3">Civil Provisions of General Application</unit>
	</structure>
	<section_number>20-88.45</section_number>
	<catch_line>Action by minor parent</catch_line>
	<text>
		A minor parent, or a guardian or other legal representative of a minor parent, may maintain a proceeding on behalf of or for the benefit of the minor's child.
	</text>
	<history>1994, c. 673.</history>
</law>
