<law>
	<structure>
		<unit label="title" identifier="60.2" level="1">Unemployment Compensation</unit>
		<unit label="chapter" identifier="2" level="2">Definitions</unit>
	</structure>
	<section_number>60.2-202</section_number>
	<catch_line>Annual payroll</catch_line>
	<text>
		"Annual payroll" means the total amount of wages payable by an employer, regardless of the time of payment, for employment during a calendar year.
	</text>
	<history>Code 1950, § 60-4; 1968, c. 738, § 60.1-4; 1986, c. 480.</history>
</law>
