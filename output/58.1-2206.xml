<law>
	<structure>
		<unit label="title" identifier="58.1" level="1">Taxation</unit>
		<unit label="subtitle" identifier="II" level="2">Taxes Administered by Other Agencies</unit>
		<unit label="chapter" identifier="22" level="3">Virginia Fuels Tax Act</unit>
		<unit label="article" identifier="2" level="4">Motor Fuel Licensing</unit>
	</structure>
	<section_number>58.1-2206</section_number>
	<catch_line>Persons who may obtain a license</catch_line>
	<text>
		A person who conducts the activities of a distributor or a permissive supplier may obtain a license issued by the Commissioner for that activity.
	</text>
	<history>2000, cc. 729, 758.</history>
