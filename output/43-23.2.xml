<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="43" level="1">Mechanics' and Certain Other Liens</unit>
		<unit label="chapter" identifier="1" level="2">Mechanics' and Materialmen's Liens</unit>
	</structure>
	<section_number>43-23.2</section_number>
	<catch_line>Remedies cumulative</catch_line>
	<text>
		The remedies afforded by this chapter shall be deemed cumulative in nature and not be construed to be in lieu of any other legal or equitable remedies.
	</text>
	<history>1968, c. 568.</history>
</law>
