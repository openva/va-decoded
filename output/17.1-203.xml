<law>
	<structure>
		<unit label="title" identifier="17.1" level="1">Courts of Record</unit>
		<unit label="chapter" identifier="2" level="2">Clerks, Clerks' Offices and Records</unit>
		<unit label="article" identifier="1" level="3">Clerk of Supreme Court</unit>
	</structure>
	<section_number>17.1-203</section_number>
	<catch_line>Where clerk's offices to be kept</catch_line>
	<text>
		The clerk of the Supreme Court shall maintain a clerk's office at Richmond, at such place as the Court shall direct.
	</text>
	<history>Code 1919, § 3385, § 17-37; 1938, p. 132; 1998, c. 872.</history>
</law>
