<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="53" level="3">Hospital Authorities</unit>
		<unit label="article" identifier="2" level="4">Powers</unit>
	</structure>
	<section_number>15.2-5328</section_number>
	<catch_line>Bylaws and rules and regulations</catch_line>
	<text>
		An authority shall have power to adopt bylaws for the conduct of its business and to adopt necessary rules and regulations for the government of the authority and its employees.
	</text>
	<history>Code 1950, § 32-241; 1979, c. 719, § 15.1-1562; 1997, c. 587.</history>
