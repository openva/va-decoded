<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="12" level="2">Reciprocal Insurance</unit>
		<unit label="article" identifier="1" level="3">General Provisions</unit>
	</structure>
	<section_number>38.2-1205</section_number>
	<catch_line>Name</catch_line>
	<text>
		Every reciprocal shall have and use a business name that includes the word "reciprocal," "interinsurer," "interinsurance," "exchange," "underwriters," or "underwriting."
	</text>
	<history>Code 1950, § 38-546; 1952, c. 317, § 38.1-694; 1986, c. 562.</history>
</law>
