<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="10.1" level="1">Conservation</unit>
		<unit label="subtitle" identifier="II" level="2">Activities Administered by Other Entities</unit>
		<unit label="chapter" identifier="14" level="3">Virginia Waste Management Act</unit>
		<unit label="article" identifier="3.6" level="4">Computer Recovery and Recycling Act</unit>
	</structure>
	<section_number>10.1-1425.36</section_number>
	<catch_line>Fees not authorized</catch_line>
	<text>
		This article does not authorize the Department to impose a fee, including a recycling fee or registration fee, on a consumer, manufacturer, retailer, or person who recycles or reuses computer equipment.
	</text>
	<history>2008, c. 541.</history>
</law>
