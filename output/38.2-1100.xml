<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="11" level="2">Captive Insurers</unit>
	</structure>
	<section_number>38.2-1100</section_number>
	<catch_line>Scope of chapter</catch_line>
	<text>
		The provisions of this chapter shall apply solely to captive insurers or association captive insurers domiciled in this Commonwealth.
	</text>
	<history>1980, c. 665, § 38.1-916; 1986, c. 562.</history>
</law>
