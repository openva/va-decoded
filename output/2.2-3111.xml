<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="2.2" level="1">Administration of Government</unit>
		<unit label="subtitle" identifier="I" level="2">Organization of State Government</unit>
		<unit label="part" identifier="E" level="3">State Officers and Employees</unit>
		<unit label="chapter" identifier="31" level="4">State and Local Government Conflict of Interests Act</unit>
		<unit label="article" identifier="4" level="5">Prohibited Conduct Relating to Transactions</unit>
	</structure>
	<section_number>2.2-3111</section_number>
	<catch_line>Application</catch_line>
	<text>
		This article proscribes certain conduct by state and local government officers and employees having a personal interest in a transaction.
	</text>
	<history>1987, Sp. Sess., c. 1, § 2.1-639.10; 2001, c. 844.</history>
</law>
