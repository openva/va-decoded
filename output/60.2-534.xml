<law>
	<structure>
		<unit label="title" identifier="60.2" level="1">Unemployment Compensation</unit>
		<unit label="chapter" identifier="5" level="2">Taxation</unit>
		<unit label="article" identifier="4" level="3">Computation of Tax Rate</unit>
	</structure>
	<section_number>60.2-534</section_number>
	<catch_line>Tax rate defined</catch_line>
	<text>
		As used in this article "tax rate" means the tax or percentage of wages payable by an employer with respect to employment.
	</text>
	<history>Code 1950, § 60-74; 1968, c. 738, § 60.1-87; 1986, c. 480.</history>
</law>
