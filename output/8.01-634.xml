<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="24" level="2">Injunctions</unit>
	</structure>
	<section_number>8.01-634</section_number>
	<catch_line>Dismissal of injunction bill</catch_line>
	<text>
		When an injunction is wholly dissolved the bill shall stand dismissed with costs, unless sufficient cause be shown against such dismissal.
	</text>
	<history>Code 1950, § 8-626; 1977, c. 617.</history>
</law>
