<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="II" level="2">Wills and Decedents' Estates</unit>
		<unit label="chapter" identifier="6" level="3">Transfers Without Qualification</unit>
		<unit label="article" identifier="5" level="4">Uniform Real Property Transfer on Death Act</unit>
	</structure>
	<section_number>64.2-627</section_number>
	<catch_line>Capacity of transferor</catch_line>
	<text>
		The capacity required to make or revoke a transfer on death deed is the same as the capacity required to make a will.
	</text>
	<history>2013, c. 390.</history>
</law>
