<law>
	<structure>
		<unit label="title" identifier="55.1" level="1">Property and Conveyances</unit>
		<unit label="subtitle" identifier="II" level="2">Real Estate Settlements and Recordation</unit>
		<unit label="chapter" identifier="6" level="3">Recordation of Documents</unit>
		<unit label="article" identifier="7" level="4">Uniform Federal Lien Registration Act</unit>
	</structure>
	<section_number>55.1-659</section_number>
	<catch_line>Certificates and notices affecting liens filed on or before July 1, 1970</catch_line>
	<text>
		If a notice of lien was filed on or before July 1, 1970, any certificate or notice affecting the lien shall be filed in the same office.
	</text>
	<history>1970, c. 76, § 55-142.8; 2019, c. 712.</history>
</law>
