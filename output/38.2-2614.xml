<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="26" level="2">Home Protection Companies</unit>
	</structure>
	<section_number>38.2-2614</section_number>
	<catch_line>Fronting not permitted</catch_line>
	<text>
		No licensed insurer or licensed home protection company shall act as a fronting company for any unlicensed insurer or unlicensed home protection company.
	</text>
	<history>1981, c. 530, § 38.1-944; 1986, c. 562.</history>
</law>
