<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Actions</unit>
		<unit label="article" identifier="3" level="3">Injury to Person or Property</unit>
	</structure>
	<section_number>8.01-34</section_number>
	<catch_line>When contribution among wrongdoers enforced</catch_line>
	<text>
		Contribution among wrongdoers may be enforced when the wrong results from negligence and involves no moral turpitude.
	</text>
	<history>Code 1950, § 8-627; 1977, c. 617.</history>
</law>
