<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="17.1" level="1">Courts of Record</unit>
		<unit label="chapter" identifier="6" level="2">Costs Generally</unit>
	</structure>
	<section_number>17.1-604</section_number>
	<catch_line>Costs in appellate courts</catch_line>
	<text>
		In every case in the Supreme Court or the Court of Appeals, costs shall be recovered in such court by the party substantially prevailing.
	</text>
	<history>Code 1950, § 14-178; 1964, c. 386, § 14.1-181; 1971, Ex. Sess., c. 156; 1988, c. 525; 1998, c. 872.</history>
</law>
