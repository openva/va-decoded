	<section_number>8.1A-101</section_number>
	<catch_line>Short titles</catch_line>
	<text>
		<section prefix="a">Titles 8.1A through 8.9A may be cited as the Uniform Commercial Code.
		</section>
		<section prefix="b">This title may be cited as Uniform Commercial Code -- General Provisions.
		</section>
	</text>
	<history>1964, c. 219, § 8.1-101; 2003, c. 353.</history>
