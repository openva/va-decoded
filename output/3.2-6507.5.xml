		<unit label="chapter" identifier="65" level="3">Comprehensive Animal Care</unit>
		<unit label="article" identifier="2.1" level="4">Commercial Dog Breeding Operations</unit>
	</structure>
	<section_number>3.2-6507.5</section_number>
	<catch_line>Penalty</catch_line>
	<text>
		Any commercial dog breeder violating any provision of this article is guilty of a Class 1 misdemeanor.
	</text>
