<law>
	<structure>
		<unit label="title" identifier="57" level="1">Religious and Charitable Matters; Cemeteries</unit>
		<unit label="chapter" identifier="3" level="2">Cemeteries</unit>
		<unit label="article" identifier="7" level="3">Cremation</unit>
	</structure>
	<section_number>57-39.19</section_number>
	<catch_line>Application of §§ 54.1-2818.1 through 54.1-2818.3</catch_line>
	<text>
		The provisions of §§ 54.1-2818.1 through 54.1-2818.3 shall apply to the cremation of any dead human body.
	</text>
	<history>1979, c. 724.</history>
</law>
