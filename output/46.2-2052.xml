<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="20" level="3">Regulation of Passenger Carriers</unit>
		<unit label="article" identifier="2" level="4">Insurance Requirements</unit>
	</structure>
	<section_number>46.2-2052</section_number>
	<catch_line>Bonds or insurance to be kept in force; amounts</catch_line>
	<text>
		Each motor carrier shall keep in force at all times insurance, a bond, or bonds, in an amount required by this article.
	</text>
	<history>2001, c. 596.</history>
</law>
