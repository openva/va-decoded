		<unit label="part" identifier="B" level="3">Transaction of Public Business</unit>
		<unit label="chapter" identifier="43" level="4">Virginia Public Procurement Act</unit>
		<unit label="article" identifier="2" level="5">Contract Formation and Administration</unit>
	</structure>
	<section_number>2.2-4339</section_number>
	<catch_line>Bonds on other than construction contracts</catch_line>
	<text>
		A public body may require bid, payment, or performance bonds for contracts for goods or services if provided in the Invitation to Bid or Request for Proposal.
	</text>
	<history>1982, c. 647, § 11-62; 2001, c. 844.</history>
</law>
