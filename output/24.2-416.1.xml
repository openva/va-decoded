<law>
	<structure>
		<unit label="title" identifier="24.2" level="1">Elections</unit>
		<unit label="chapter" identifier="4" level="2">Voter Registration</unit>
		<unit label="article" identifier="3.1" level="3">Mail Registration</unit>
