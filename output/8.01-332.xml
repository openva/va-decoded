<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="10" level="2">Dockets</unit>
	</structure>
	<section_number>8.01-332</section_number>
	<catch_line>Calling current docket</catch_line>
	<text>
		The current docket may be called for the purpose of fixing cases for trial, on such days or at such intervals as may be directed by order of court.
	</text>
	<history>Code 1950, §§ 8-162, 8-167; 1977, c. 617.</history>
</law>
