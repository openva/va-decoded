<law>
	<structure>
		<unit label="title" identifier="55.1" level="1">Property and Conveyances</unit>
		<unit label="subtitle" identifier="I" level="2">Property Conveyances</unit>
		<unit label="chapter" identifier="1" level="3">Creation and Limitation of Estates</unit>
		<unit label="article" identifier="1" level="4">Creation and Transfer of Estates</unit>
	</structure>
	<section_number>55.1-104</section_number>
	<catch_line>Estates to lie in grant as well as in livery</catch_line>
	<text>
		All real estate shall, as regards the conveyance of the immediate freehold thereof, be deemed to lie in grant as well as in livery.
	</text>
	<history>Code 1919, § 5146; Code 1950, § 55-5; 2019, c. 712.</history>
</law>
