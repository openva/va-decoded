<law>
	<structure>
		<unit label="title" identifier="6.2" level="1">Financial Institutions and Services</unit>
		<unit label="subtitle" identifier="II" level="2">Depository Institutions and Trust Organizations</unit>
		<unit label="chapter" identifier="8" level="3">Banks</unit>
		<unit label="article" identifier="6" level="4">Interstate Branching</unit>
	</structure>
	<section_number>6.2-838</section_number>
	<catch_line>Interstate branching</catch_line>
	<text>
		An out-of-state bank that does not already maintain a branch in the Commonwealth and that meets the requirements of this article may establish and maintain a de novo branch in the Commonwealth.
	</text>
	<history>1995, c. 301, § 6.1-44.4; 2010, c. 794.</history>
</law>
