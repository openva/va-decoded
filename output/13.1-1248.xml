<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="14" level="2">Virginia Business Trust Act</unit>
		<unit label="article" identifier="9" level="3">Foreign Business Trusts</unit>
	</structure>
	<section_number>13.1-1248</section_number>
	<catch_line>Actions by Attorney General</catch_line>
	<text>
		The Attorney General may bring an action to restrain a foreign business trust from transacting business in this Commonwealth in violation of this article.
	</text>
	<history>2002, c. 621.</history>
</law>
