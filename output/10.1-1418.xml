<law>
	<structure>
		<unit label="title" identifier="10.1" level="1">Conservation</unit>
		<unit label="subtitle" identifier="II" level="2">Activities Administered by Other Entities</unit>
		<unit label="chapter" identifier="14" level="3">Virginia Waste Management Act</unit>
		<unit label="article" identifier="3" level="4">Litter Control and Recycling</unit>
	</structure>
	<section_number>10.1-1418</section_number>
	<catch_line>Penalty for violation of article</catch_line>
	<text>
		Every person convicted of a violation of this article for which no penalty is specifically provided shall be punished by a fine of not more than fifty dollars for each such violation.
	</text>
	<history>1987, c. 234, § 10-277.5; 1988, c. 891.</history>
</law>
