<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="23.1" level="1">Institutions of Higher Education; Other Educational and Cultural Institutions</unit>
		<unit label="subtitle" identifier="IV" level="2">Public Institutions of Higher Education</unit>
		<unit label="chapter" identifier="17" level="3">Longwood University</unit>
	</structure>
	<section_number>23.1-1702</section_number>
	<catch_line>Powers and duties</catch_line>
	<text>
		<section prefix="A">The board shall appoint all teachers and agents and fix their salaries and generally direct the affairs of the University.
		</section>
		<section prefix="B">The board may confer degrees.
		</section>
	</text>
	<history>1964, c. 159, §§ 23-188, 23-190; 2002, cc. 158, 257; 2016, c. 588.</history>
</law>
