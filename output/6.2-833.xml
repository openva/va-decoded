	<structure>
		<unit label="title" identifier="6.2" level="1">Financial Institutions and Services</unit>
		<unit label="subtitle" identifier="II" level="2">Depository Institutions and Trust Organizations</unit>
		<unit label="chapter" identifier="8" level="3">Banks</unit>
		<unit label="article" identifier="5" level="4">Branches and Facilities</unit>
	</structure>
	<section_number>6.2-833</section_number>
	<catch_line>Bank agent for depository institution</catch_line>
	<text>
		A bank may act as the agent of any other depository institution in receiving deposits and providing other services without being deemed a branch of such other depository institution.
	</text>
	<history>1995, c. 301, § 6.1-39.5; 1997, c. 24; 2010, c. 794.</history>
</law>
