<law>
	<structure>
		<unit label="title" identifier="29.1" level="1">Wildlife, Inland Fisheries and Boating</unit>
		<unit label="chapter" identifier="4" level="2">Permits Required</unit>
		<unit label="article" identifier="1" level="3">Dealing in Furs</unit>
	</structure>
	<section_number>29.1-403</section_number>
	<catch_line>Term of permits; application</catch_line>
	<text>
		All fur permits shall be for the fiscal year, July 1 through June 30, and shall be obtained from the Department by written application.
	</text>
	<history>Code 1950, § 29-98; 1987, c. 488.</history>
</law>
