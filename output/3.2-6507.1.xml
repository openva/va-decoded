<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="3.2" level="1">Agriculture, Animal Care, and Food</unit>
		<unit label="subtitle" identifier="V" level="2">Domestic Animals</unit>
		<unit label="chapter" identifier="65" level="3">Comprehensive Animal Care</unit>
		<unit label="article" identifier="2.1" level="4">Commercial Dog Breeding Operations</unit>
	</structure>
	<section_number>3.2-6507.1</section_number>
	<catch_line>Business license required</catch_line>
	<text>
		No commercial dog breeder shall breed dogs in the Commonwealth without a valid business license issued by any locality, as applicable, where he maintains dogs for the purpose of commercial dog breeding.
	</text>
	<history>2008, c. 852, § 3.1-796.77:1.</history>
</law>
