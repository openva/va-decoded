<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="3" level="2">Cooperative Associations</unit>
		<unit label="article" identifier="3" level="3">Worker Cooperatives</unit>
	</structure>
	<section_number>13.1-349</section_number>
	<catch_line>Application of other laws</catch_line>
	<text>
		Except as otherwise provided in this article, worker cooperatives shall be governed by Article 1 (§ 13.1-301 et seq.) and Chapter 9 (§ 13.1-601 et seq.).
	</text>
	<history>2020, c. 673.</history>
</law>
