<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="57" level="3">Park Authorities Act</unit>
	</structure>
	<section_number>15.2-5708</section_number>
	<catch_line>Exemption from taxation</catch_line>
	<text>
		No authority shall be required to pay any taxes or assessments upon any park acquired and constructed by it under the provisions of this chapter.
	</text>
	<history>Code 1950, § 15-714.6; 1950, p. 1248; 1962, c. 623, § 15.1-1233; 1997, c. 587.</history>
</law>
