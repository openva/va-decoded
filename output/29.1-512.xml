<law>
	<structure>
		<unit label="title" identifier="29.1" level="1">Wildlife, Inland Fisheries and Boating</unit>
		<unit label="chapter" identifier="5" level="2">Wildlife and Fish Laws</unit>
		<unit label="article" identifier="2" level="3">Hunting and Trapping</unit>
	</structure>
	<section_number>29.1-512</section_number>
	<catch_line>Closed season on other species</catch_line>
	<text>
		There shall be a continuous closed hunting season on all birds and wild animals which are not nuisance species as defined in § 29.1-100, except as provided by law.
	</text>
	<history>Code 1950, § 29-134; 1974, c. 302; 1987, c. 488.</history>
</law>
