<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="13" level="2">Grand Juries</unit>
		<unit label="article" identifier="2" level="3">Regular Grand Juries</unit>
	</structure>
	<section_number>19.2-196</section_number>
	<catch_line>How deficiency of jurors supplied</catch_line>
	<text>
		If a sufficient number of grand jurors do not appear, the court may order the deficiency to be supplied from the bystanders or from a list furnished by the judge to the sheriff or sergeant.
	</text>
	<history>Code 1950, § 19.1-151; 1960, c. 366; 1975, c. 495.</history>
</law>
