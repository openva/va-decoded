<law>
	<structure>
		<unit label="title" identifier="36" level="1">Housing</unit>
		<unit label="chapter" identifier="1" level="2">Housing Authorities Law</unit>
		<unit label="article" identifier="2" level="3">Commissioners, Officers, Agents and Employees</unit>
	</structure>
	<section_number>36-15</section_number>
	<catch_line>Delegation of authority</catch_line>
	<text>
		An authority may delegate to one or more of its agents or employees such powers or duties as it may deem proper.
	</text>
	<history>1938, p. 450; Michie Code 1942, § 3145(5).</history>
</law>
