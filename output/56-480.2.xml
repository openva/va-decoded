<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="56" level="1">Public Service Companies</unit>
		<unit label="chapter" identifier="15" level="2">Telegraph and Telephone Companies</unit>
		<unit label="article" identifier="3" level="3">Supervision by Commission</unit>
	</structure>
	<section_number>56-480.2</section_number>
	<catch_line>Operator assistance at pay stations</catch_line>
	<text>
		No telephone company shall require the deposit of money in any pay station as a prerequisite to reaching the operator from such station.
	</text>
	<history>1979, c. 71.</history>
</law>
