<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Actions</unit>
		<unit label="article" identifier="17" level="3">Declaratory Judgments</unit>
	</structure>
	<section_number>8.01-185</section_number>
	<catch_line>Venue</catch_line>
	<text>
		The venue of actions seeking declarations of right with or without consequential relief shall be determined in accordance with provisions of Chapter 5 (§ 8.01-257 et seq.) of this title.
	</text>
	<history>Code 1950, § 8-579; 1954, c. 333; 1977, c. 617.</history>
</law>
