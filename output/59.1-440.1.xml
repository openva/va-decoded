<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="34" level="2">Extended Service Contract Act</unit>
	</structure>
	<section_number>59.1-440.1</section_number>
	<catch_line>Extended service contracts not insurance</catch_line>
	<text>
		Extended service contracts are (i) not contracts of insurance in the Commonwealth and (ii) not subject to regulation under Title 38.2.
	</text>
	<history>2014, c. 193.</history>
</law>
