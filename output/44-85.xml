<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="44" level="1">Military and Emergency Laws</unit>
		<unit label="chapter" identifier="1" level="2">Military Laws of Virginia</unit>
		<unit label="article" identifier="8" level="3">Unorganized Militia</unit>
	</structure>
	<section_number>44-85</section_number>
	<catch_line>Regulations and penalties</catch_line>
	<text>
		Whenever any part of the unorganized militia is ordered out, it shall be governed by the same rules and regulations and be subject to the same penalties as the National Guard.
	</text>
	<history>1930, p. 965; Michie Code 1942, § 2673(71); 2015, c. 221.</history>
</law>
