<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="58.1" level="1">Taxation</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Sources of State Revenue</unit>
		<unit label="chapter" identifier="40" level="3">Virginia Lottery Law; Sports Betting</unit>
		<unit label="article" identifier="2" level="4">Sports Betting</unit>
	</structure>
	<section_number>58.1-4040</section_number>
	<catch_line>Underage betting prohibited; penalty</catch_line>
	<text>
		<section prefix="A">No person shall knowingly accept or redeem a sports bet by, or knowingly offer to accept or redeem a sports bet on behalf of, a person under the age of 21 years.
		</section>
		<section prefix="B">Any person convicted of violating this section is guilty of a Class 1 misdemeanor.
		</section>
	</text>
	<history>2020, cc. 1218, 1256.</history>
</law>
