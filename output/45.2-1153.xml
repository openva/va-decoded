<law>
	<structure>
		<unit label="title" identifier="45.2" level="1">Mines, Minerals, and Energy</unit>
		<unit label="subtitle" identifier="III" level="2">Mineral Mines</unit>
		<unit label="part" identifier="A" level="3">Mineral Mines Generally</unit>
		<unit label="chapter" identifier="11" level="4">Mineral Mine Safety Act</unit>
		<unit label="article" identifier="7" level="5">Mine Inspections</unit>
	</structure>
	<section_number>45.2-1153</section_number>
	<catch_line> Denial of entry</catch_line>
	<text>
		No person shall deny the Director or any mine inspector entry upon or through a mine for the purpose of conducting an inspection or into any office at the site where maps or records relating to the mine are located, pursuant to the Act.
	</text>
	<history>1997, c. 390, § 45.1-161.292:59; 2021, Sp. Sess. I, c. 387.</history>
</law>
