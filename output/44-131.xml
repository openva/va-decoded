<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="44" level="1">Military and Emergency Laws</unit>
		<unit label="chapter" identifier="2" level="2">Armories, Buildings and Grounds</unit>
	</structure>
	<section_number>44-131</section_number>
	<catch_line>Military property exempt from taxation</catch_line>
	<text>
		All property actually used for armory and military training purposes, as hereinabove defined, shall be exempt from all taxation, impost or assessment.
	</text>
	<history>1932, p. 760; Michie Code 1942, § 2673(114); R. P. 1948, § 44-131.</history>
</law>
