<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="21" level="3">Regulation of Property Carriers</unit>
		<unit label="article" identifier="4" level="4">Household Goods Carriers</unit>
	</structure>
	<section_number>46.2-2153</section_number>
	<catch_line>Provisions of chapter controlling</catch_line>
	<text>
		As to household goods carriers, the provisions of this chapter shall be controlling, and no laws in conflict herewith, or inconsistent herewith, shall have any application to such carriers.
	</text>
	<history>2001, c. 596.</history>
</law>
