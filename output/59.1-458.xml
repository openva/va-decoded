<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="37" level="2">Contracts; Independent Sales Representatives</unit>
	</structure>
	<section_number>59.1-458</section_number>
	<catch_line>Waiver prohibited</catch_line>
	<text>
		Any provision of any agreement intending to waive the rights of any party to any provision of this chapter shall be void.
	</text>
	<history>1993, c. 736.</history>
</law>
