<law>
	<structure>
		<unit label="title" identifier="29.1" level="1">Wildlife, Inland Fisheries and Boating</unit>
		<unit label="chapter" identifier="5" level="2">Wildlife and Fish Laws</unit>
		<unit label="article" identifier="7" level="3">Nonindigenous Aquatic Nuisance Species Act</unit>
	</structure>
	<section_number>29.1-572</section_number>
	<catch_line>Authority of Board; regulations</catch_line>
	<text>
		The Board may promulgate regulations necessary to carry out the provisions of this article including, but not limited to, the designation of other nonindigenous aquatic nuisance species.
	</text>
	<history>2003, c. 446.</history>
