<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="21" level="2">Arbitration and Award</unit>
		<unit label="article" identifier="2" level="3">Uniform Arbitration Act</unit>
	</structure>
	<section_number>8.01-581.05</section_number>
	<catch_line>Representation by attorney</catch_line>
	<text>
		A party has the right to be represented by an attorney at any proceeding or hearing under this article. A waiver thereof prior to the proceeding or hearing is ineffective.
	</text>
	<history>1986, c. 614.</history>
</law>
