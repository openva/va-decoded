<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="57" level="1">Religious and Charitable Matters; Cemeteries</unit>
		<unit label="chapter" identifier="3" level="2">Cemeteries</unit>
		<unit label="article" identifier="4" level="3">Abandonment; Removal of Remains</unit>
	</structure>
	<section_number>57-38</section_number>
	<catch_line>Exemption from §§ 57-36 and 57-37</catch_line>
	<text>
		Sections 57-36 and 57-37 shall not apply to any graveyard or cemetery owned by a church, or controlled by trustees, in which sections are sold.
	</text>
	<history>Code 1919, § 55.</history>
</law>
