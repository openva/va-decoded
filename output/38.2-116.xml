	<section_number>38.2-116</section_number>
	<catch_line>Animal</catch_line>
	<text>
		"Animal insurance" means insurance against loss of or damage to any animal resulting from any cause.
	</text>
	<history>1952, c. 317, § 38.1-13; 1986, c. 562.</history>
</law>
