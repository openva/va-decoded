<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="11" level="1">Contracts</unit>
		<unit label="chapter" identifier="2" level="2">Compromise and Satisfaction</unit>
	</structure>
	<section_number>11-13</section_number>
	<catch_line>Right of contribution not affected</catch_line>
	<text>
		Nothing contained in §§ 11-10 through 11-12 shall affect or impair the right of contribution between joint contractors and co-obligors.
	</text>
	<history>Code 1919, § 5766.</history>
</law>
