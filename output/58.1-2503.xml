<law>
	<structure>
		<unit label="title" identifier="58.1" level="1">Taxation</unit>
		<unit label="subtitle" identifier="II" level="2">Taxes Administered by Other Agencies</unit>
		<unit label="chapter" identifier="25" level="3">License Tax on Certain Insurance Companies</unit>
		<unit label="article" identifier="1" level="4">Levy</unit>
	</structure>
	<section_number>58.1-2503</section_number>
	<catch_line>When tax payable</catch_line>
	<text>
		The annual license tax shall be transmitted to the Department on or before March 1 of each year for deposit into the state treasury.
	</text>
	<history>Code 1950, § 58-489; 1952, c. 190; 1968, c. 13; 1978, c. 4; 1984, c. 675; 2011, c. 850.</history>
