<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="47.1" level="1">Notaries and Out-Of-State Commissioners</unit>
		<unit label="chapter" identifier="6" level="2">Civil and Criminal Liability</unit>
	</structure>
	<section_number>47.1-26</section_number>
	<catch_line>Civil liability of notary</catch_line>
	<text>
		A notary public shall be liable for all damages proximately caused by his official misconduct.
	</text>
	<history>Code 1950, § 47-3; 1972, c. 824; 1980, c. 580.</history>
</law>
