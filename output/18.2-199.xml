<law>
	<structure>
		<unit label="title" identifier="18.2" level="1">Crimes and Offenses Generally</unit>
		<unit label="chapter" identifier="6" level="2">Crimes Involving Fraud</unit>
		<unit label="article" identifier="6" level="3">Offenses Relating to Credit Cards</unit>
