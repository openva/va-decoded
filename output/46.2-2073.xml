<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="20" level="3">Regulation of Passenger Carriers</unit>
		<unit label="article" identifier="5" level="4">Nonprofit/Tax-Exempt Passenger Carriers</unit>
	</structure>
	<section_number>46.2-2073</section_number>
	<catch_line>Exemption from permit filing fees</catch_line>
	<text>
		The original permit filing fee collected pursuant to this chapter shall not be applicable to non-profit/tax-exempt passenger carriers.
	</text>
	<history>2001, c. 596.</history>
</law>
