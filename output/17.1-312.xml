<law>
	<structure>
		<unit label="title" identifier="17.1" level="1">Courts of Record</unit>
		<unit label="chapter" identifier="3" level="2">Supreme Court</unit>
		<unit label="article" identifier="1" level="3">Composition, Jurisdiction, Etc</unit>
