<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="60.2" level="1">Unemployment Compensation</unit>
		<unit label="chapter" identifier="2" level="2">Definitions</unit>
	</structure>
	<section_number>60.2-205</section_number>
	<catch_line>Benefits</catch_line>
	<text>
		"Benefits" means the money payments payable to an individual, as provided in this title, with respect to his unemployment.
	</text>
	<history>Code 1950, § 60-7; 1968, c. 738, § 60.1-7; 1986, c. 480.</history>
</law>
