<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="III" level="2">Operation</unit>
		<unit label="chapter" identifier="10" level="3">Motor Vehicle and Equipment Safety</unit>
		<unit label="article" identifier="7" level="4">Horns, Sirens, and Whistles</unit>
	</structure>
	<section_number>46.2-1059</section_number>
	<catch_line>Horns</catch_line>
	<text>
		Every motor vehicle driven on a highway shall be equipped with a working horn capable of emitting sound audible under normal conditions for at least 200 feet.
	</text>
	<history>Code 1950, § 46-289; 1958, c. 541, § 46.1-283; 1989, c. 727.</history>
</law>
