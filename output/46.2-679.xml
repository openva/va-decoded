<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="II" level="2">Titling, Registration and Licensure</unit>
		<unit label="chapter" identifier="6" level="3">Titling and Registration of Motor Vehicles</unit>
		<unit label="article" identifier="6" level="4">Exemptions From Registration</unit>
	</structure>
	<section_number>46.2-679</section_number>
	<catch_line>Snowmobiles</catch_line>
	<text>
		No person shall be required to obtain the registration certificate, license plates, or decals for or pay a registration fee for any snowmobile.
	</text>
	<history>1973, c. 194, § 46.1-45.2; 1980, c. 37; 1986, c. 220; 1987, cc. 151, 342, 388; 1989, c. 727; 2016, c. 142.</history>
</law>
