<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="25" level="2">Virginia Membership Camping Act</unit>
		<unit label="article" identifier="3" level="3">Protection of Purchasers</unit>
	</structure>
	<section_number>59.1-330.1</section_number>
	<catch_line>Noncomplying contract voidable</catch_line>
	<text>
		Any membership camping contract which does not comply with the applicable provisions of this chapter shall be voidable at the option of the purchaser.
	</text>
	<history>1992, c. 545.</history>
</law>
