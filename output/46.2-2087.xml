<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="20" level="3">Regulation of Passenger Carriers</unit>
		<unit label="article" identifier="6" level="4">Common Carriers</unit>
	</structure>
	<section_number>46.2-2087</section_number>
	<catch_line>Refusal of service</catch_line>
	<text>
		No common carrier regulated pursuant to this chapter shall refuse service without good cause. The Department may, at any time, require an explanation from such carrier for its refusal to provide service.
	</text>
	<history>2001, c. 596.</history>
</law>
