<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="III" level="2">Trusts</unit>
		<unit label="chapter" identifier="7" level="3">Uniform Trust Code</unit>
		<unit label="article" identifier="9" level="4">Uniform Prudent Investor Act</unit>
	</structure>
	<section_number>64.2-783</section_number>
	<catch_line>Diversification by trustee</catch_line>
	<text>
		A trustee shall diversify the investments of the trust unless the trustee reasonably determines that, because of special circumstances, the purposes of the trust are better served without diversifying.
	</text>
	<history>1999, c. 772, § 26-45.5; 2012, c. 614.</history>
</law>
