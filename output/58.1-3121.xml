<law>
	<structure>
		<unit label="title" identifier="58.1" level="1">Taxation</unit>
		<unit label="subtitle" identifier="III" level="2">Local Taxes</unit>
		<unit label="chapter" identifier="31" level="3">Local Officers</unit>
		<unit label="article" identifier="1" level="4">Commissioners of the Revenue</unit>
