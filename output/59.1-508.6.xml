<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="43" level="2">Uniform Computer Information Transactions Act</unit>
		<unit label="article" identifier="8" level="3">Remedies</unit>
	</structure>
	<section_number>59.1-508.6</section_number>
	<catch_line>Remedies for fraud</catch_line>
	<text>
		Remedies for material misrepresentation or fraud include all remedies available under this chapter for nonfraudulent breach of contract.
	</text>
	<history>2000, cc. 101, 996.</history>
</law>
