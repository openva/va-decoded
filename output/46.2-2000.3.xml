<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="20" level="3">Regulation of Passenger Carriers</unit>
		<unit label="article" identifier="1" level="4">Motor Carriers of Passengers -- Generally</unit>
	</structure>
	<section_number>46.2-2000.3</section_number>
	<catch_line>Disposition of funds collected</catch_line>
	<text>
		Except as otherwise provided, all fees collected by the Department pursuant to this chapter shall be paid into the state treasury and set aside as a special fund to be used to meet the expenses of the Department.
	</text>
	<history>2001, c. 596.</history>
</law>
