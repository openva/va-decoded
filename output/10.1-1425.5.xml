<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="10.1" level="1">Conservation</unit>
		<unit label="subtitle" identifier="II" level="2">Activities Administered by Other Entities</unit>
		<unit label="chapter" identifier="14" level="3">Virginia Waste Management Act</unit>
		<unit label="article" identifier="3.1" level="4">Lead Acid Batteries</unit>
	</structure>
	<section_number>10.1-1425.5</section_number>
	<catch_line>Construction of article</catch_line>
	<text>
		The provisions of this article shall not be construed to prohibit any person who does not sell new lead acid batteries from collecting and recycling such batteries.
	</text>
	<history>1990, c. 520.</history>
</law>
