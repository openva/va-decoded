<law>
	<structure>
		<unit label="title" identifier="22.1" level="1">Education</unit>
		<unit label="chapter" identifier="14" level="2">Pupils</unit>
		<unit label="article" identifier="1" level="3">Compulsory School Attendance</unit>
	</structure>
	<section_number>22.1-269</section_number>
	<catch_line>Board to enforce</catch_line>
	<text>
		The Board of Education shall have the authority and it shall be its duty to see that the provisions of this article are properly enforced throughout the Commonwealth.
	</text>
	<history>Code 1950, § 22-275.23; 1959, Ex. Sess., c. 72; 1968, c. 178; 1980, c. 559.</history>
