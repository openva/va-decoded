<law>
	<structure>
		<unit label="title" identifier="8.9A" level="1">Commercial Code — Secured Transactions</unit>
		<unit label="part" identifier="3" level="2">Perfection and Priority</unit>
		<unit label="subpart" identifier="3" level="3">Priority</unit>
	</structure>
	<section_number>8.9A-339</section_number>
	<catch_line>Priority subject to subordination</catch_line>
	<text>
		This title does not preclude subordination by agreement by a person entitled to priority.
	</text>
	<history>1964, c. 219, § 8.9-316; 2000, c. 1007.</history>
</law>
