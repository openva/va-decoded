<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="11" level="2">Proceedings on Question of Insanity</unit>
	</structure>
	<section_number>19.2-167</section_number>
	<catch_line>Accused not to be tried while insane or feebleminded</catch_line>
	<text>
		No person shall, while he is insane or feebleminded, be tried for a criminal offense.
	</text>
	<history>Code 1950, § 19.1-227; 1960, c. 366; 1964, c. 231; 1968, c. 789; 1975, c. 495.</history>
</law>
