<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Actions</unit>
		<unit label="article" identifier="4" level="3">Defamation</unit>
	</structure>
	<section_number>8.01-45</section_number>
	<catch_line>Action for insulting words</catch_line>
	<text>
		All words shall be actionable which from their usual construction and common acceptance are construed as insults and tend to violence and breach of the peace.
	</text>
	<history>Code 1950, § 8-630; 1977, c. 617.</history>
</law>
