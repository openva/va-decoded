<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="9" level="2">Personal Jurisdiction in Certain Actions</unit>
	</structure>
	<section_number>8.01-330</section_number>
	<catch_line>Jurisdiction on any other basis authorized</catch_line>
	<text>
		A court of this State may exercise jurisdiction on any other basis authorized by law.
	</text>
	<history>Code 1950, § 8-81.5; 1964, c. 331; 1977, c. 617.</history>
