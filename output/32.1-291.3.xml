<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="32.1" level="1">Health</unit>
		<unit label="chapter" identifier="8" level="2">Postmortem Examinations and Services</unit>
		<unit label="article" identifier="2" level="3">Anatomical Gifts</unit>
	</structure>
	<section_number>32.1-291.3</section_number>
	<catch_line>Applicability of Act</catch_line>
	<text>
		This Act applies to an anatomical gift or amendment to, revocation of, or refusal to make an anatomical gift, whenever made.
	</text>
	<history>2007, cc. 92, 907.</history>
</law>
