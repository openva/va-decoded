<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="1" level="2">General Provisions</unit>
		<unit label="article" identifier="2" level="3">Insurance Classified and Defined</unit>
