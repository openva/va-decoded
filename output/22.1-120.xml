<law>
	<structure>
		<unit label="title" identifier="22.1" level="1">Education</unit>
		<unit label="chapter" identifier="8" level="2">Public School Funds</unit>
		<unit label="article" identifier="5" level="3">Treasurers; Accounts</unit>
	</structure>
	<section_number>22.1-120</section_number>
	<catch_line>Settlement by treasurer</catch_line>
	<text>
		Treasurers or other fiscal agents shall settle with school boards for the school funds as of June thirtieth of each year not later than August fifteenth of each year.
	</text>
	<history>Code 1950, § 22-135; 1980, c. 559.</history>
</law>
