<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="20" level="3">Regulation of Passenger Carriers</unit>
		<unit label="article" identifier="1" level="4">Motor Carriers of Passengers -- Generally</unit>
	</structure>
	<section_number>46.2-2011.12</section_number>
	<catch_line>Transportation of baggage with passengers</catch_line>
	<text>
		A certificate authorizing the transportation of passengers as a motor carrier shall also be deemed to include authority to transport in the same vehicle with passengers the baggage of passengers.
	</text>
	<history>2001, c. 596.</history>
</law>
