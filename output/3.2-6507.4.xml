<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="3.2" level="1">Agriculture, Animal Care, and Food</unit>
		<unit label="subtitle" identifier="V" level="2">Domestic Animals</unit>
		<unit label="chapter" identifier="65" level="3">Comprehensive Animal Care</unit>
		<unit label="article" identifier="2.1" level="4">Commercial Dog Breeding Operations</unit>
	</structure>
	<section_number>3.2-6507.4</section_number>
	<catch_line>Concurrent operation of releasing agency prohibited</catch_line>
	<text>
		It is unlawful for a commercial dog breeder to operate or maintain a controlling interest in any releasing agency.
	</text>
	<history>2008, c. 852, § 3.1-796.77:4.</history>
</law>
