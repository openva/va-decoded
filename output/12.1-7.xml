<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="12.1" level="1">State Corporation Commission</unit>
		<unit label="chapter" identifier="2" level="2">Members of the Commission</unit>
	</structure>
	<section_number>12.1-7</section_number>
	<catch_line>Chairman</catch_line>
	<text>
		The Commission shall annually elect one of its members chairman for a one-year term commencing on February 1 of each year.
	</text>
	<history>1971, Ex. Sess., c. 157.</history>
</law>
