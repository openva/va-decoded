<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="9" level="2">Secondhand Articles</unit>
		<unit label="article" identifier="4" level="3">Scrap Metal Purchasers</unit>
	</structure>
	<section_number>59.1-136.4</section_number>
	<catch_line>Purchases of materials from minors</catch_line>
	<text>
		Scrap metal processors shall not purchase ferrous scrap, nonferrous scrap, metal articles, proprietary articles, or other scrap metal from any person under the age of 18 years.
	</text>
	<history>2007, c. 917.</history>
</law>
