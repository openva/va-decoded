<law>
	<structure>
		<unit label="title" identifier="10.1" level="1">Conservation</unit>
		<unit label="subtitle" identifier="II" level="2">Activities Administered by Other Entities</unit>
		<unit label="chapter" identifier="14" level="3">Virginia Waste Management Act</unit>
		<unit label="article" identifier="3" level="4">Litter Control and Recycling</unit>
	</structure>
	<section_number>10.1-1425</section_number>
	<catch_line>Preemption of certain local ordinances</catch_line>
	<text>
		The provisions of this article shall supersede and preempt any local ordinance which attempts to regulate the size or type of any container or package containing food or beverage or which requires a deposit on a disposable container or package.
	</text>
	<history>1987, c. 234, § 10-277.14; 1988, c. 891.</history>
</law>
