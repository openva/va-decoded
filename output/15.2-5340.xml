<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="53" level="3">Hospital Authorities</unit>
		<unit label="article" identifier="2" level="4">Powers</unit>
	</structure>
	<section_number>15.2-5340</section_number>
	<catch_line>Contracts</catch_line>
	<text>
		An authority shall have power to make and execute contracts and other instruments necessary or convenient to the exercise of the powers of the authority.
	</text>
	<history>Code 1950, § 32-255; 1979, c. 719, § 15.1-1575; 1997, c. 587.</history>
</law>
