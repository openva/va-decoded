<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="20" level="1">Domestic Relations</unit>
		<unit label="chapter" identifier="11" level="2">Uniform Collaborative Law Act</unit>
	</structure>
	<section_number>20-181</section_number>
	<catch_line>Confidentiality of collaborative law communication</catch_line>
	<text>
		A collaborative law communication is confidential to the extent agreed upon by the parties in a signed record or as provided by another law of the Commonwealth.
	</text>
	<history>2021, Sp. Sess. I, c. 346.</history>
</law>
