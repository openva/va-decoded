<law>
	<structure>
		<unit label="title" identifier="19.2" level="1">Criminal Procedure</unit>
		<unit label="chapter" identifier="3" level="2">Magistrates</unit>
		<unit label="article" identifier="6" level="3">Compensation and Fees</unit>
	</structure>
	<section_number>19.2-46</section_number>
	<catch_line>Compensation</catch_line>
	<text>
		The salaries of all magistrates shall be fixed and paid as provided in § 19.2-46.1. The salaries referred to herein shall be in lieu of all fees which may accrue to the recipient by virtue of his office.
	</text>
	<history>Code 1950, § 19.1-395; 1973, c. 545; 1974, c. 484; 1975, c. 495; 1980, c. 139; 2008, cc. 551, 691.</history>
</law>
