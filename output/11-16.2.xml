<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="11" level="1">Contracts</unit>
		<unit label="chapter" identifier="3" level="2">Gaming Contracts</unit>
	</structure>
	<section_number>11-16.2</section_number>
	<catch_line>Exemption; authorized sports betting</catch_line>
	<text>
		This chapter shall not apply to any sports betting or related activity that is lawful under Article 2 (§ 58.1-4030 et seq.) of Chapter 40 of Title 58.1.
	</text>
	<history>2020, cc. 1218, 1256, § 11-16.1.</history>
</law>
