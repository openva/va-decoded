<law>
	<structure>
		<unit label="title" identifier="54.1" level="1">Professions and Occupations</unit>
		<unit label="subtitle" identifier="III" level="2">Professions and Occupations Regulated by Boards Within the Department of Health Professions</unit>
		<unit label="chapter" identifier="34" level="3">Drug Control Act</unit>
		<unit label="article" identifier="2" level="4">Permitting of Pharmacies</unit>
	</structure>
	<section_number>54.1-3432</section_number>
	<catch_line>Supervision by pharmacist</catch_line>
	<text>
		Every pharmacy shall be under the personal supervision of a pharmacist on the premises of the pharmacy.
	</text>
	<history>Code 1950, § 54-478; 1958, c. 551; 1970, c. 650, § 54-524.51; 1988, c. 765.</history>
