<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="2.2" level="1">Administration of Government</unit>
		<unit label="subtitle" identifier="I" level="2">Organization of State Government</unit>
		<unit label="part" identifier="A" level="3">Office of the Governor</unit>
		<unit label="chapter" identifier="2" level="4">Governor's Secretaries</unit>
		<unit label="article" identifier="1" level="5">General Provisions</unit>
	</structure>
	<section_number>2.2-201</section_number>
	<catch_line>Secretaries; general; compensation</catch_line>
	<text>
		<section prefix="A">Each Secretary shall be considered an extension of the Governor in the management coordination and cohesive direction of the executive branch of state government ensuring that the laws are faithfully executed.
		</section>
		<section prefix="B">Each Secretary shall be paid the compensation fixed by law.
		</section>
	</text>
	<history>1972, c. 641, § 2.1-51.10; 1984, c. 720, § 2.1-51.10:1; 2001, c. 844.</history>
</law>
