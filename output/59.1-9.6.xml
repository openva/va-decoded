<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="1.1" level="2">Virginia Antitrust Act</unit>
	</structure>
	<section_number>59.1-9.6</section_number>
	<catch_line>Monopolies unlawful</catch_line>
	<text>
		Every conspiracy, combination, or attempt to monopolize, or monopolization of, trade or commerce of this Commonwealth is unlawful.
	</text>
	<history>1974, c. 545.</history>
</law>
