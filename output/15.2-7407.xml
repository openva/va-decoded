<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="IV" level="2">Other Governmental Entities</unit>
		<unit label="chapter" identifier="74" level="3">Eastern Shore Water Access Authority</unit>
	</structure>
	<section_number>15.2-7407</section_number>
	<catch_line>Name of authority</catch_line>
	<text>
		The name of the Authority shall be the Eastern Shore Water Access Authority. The name of the Authority may be changed upon approval of a simple majority of the directors of the Authority.
	</text>
	<history>2014, c. 471.</history>
</law>
