<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="48" level="1">Nuisances</unit>
		<unit label="chapter" identifier="1" level="2">Abating Public Nuisances Generally</unit>
	</structure>
	<section_number>48-6</section_number>
	<catch_line>Enforcement of judgment in rem</catch_line>
	<text>
		Every judgment in rem under this chapter shall be enforced in the same manner as an attachment levied on real estate.
	</text>
	<history>Code 1919, § 1520.</history>
</law>
