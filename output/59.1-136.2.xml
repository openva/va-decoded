<law>
	<structure>
		<unit label="title" identifier="59.1" level="1">Trade and Commerce</unit>
		<unit label="chapter" identifier="9" level="2">Secondhand Articles</unit>
		<unit label="article" identifier="4" level="3">Scrap Metal Purchasers</unit>
	</structure>
	<section_number>59.1-136.2</section_number>
	<catch_line>Purchases of ferrous scrap</catch_line>
	<text>
		Except as provided in § 59.1-136.4, scrap metal processors may purchase ferrous scrap directly from any person.
	</text>
	<history>2007, c. 917.</history>
</law>
