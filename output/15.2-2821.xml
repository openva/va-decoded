<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="II" level="2">Powers of Local Government</unit>
		<unit label="chapter" identifier="28.2" level="3">Virginia Indoor Clean Air Act</unit>
		<unit label="article" identifier="1" level="4">General Provisions</unit>
	</structure>
	<section_number>15.2-2821</section_number>
	<catch_line>Applicability</catch_line>
	<text>
		Nothing in this chapter shall be construed to:
		<section prefix="1">Permit smoking where it is otherwise prohibited or restricted by other applicable provisions of law; or
		</section>
		<section prefix="2">Regulate smoking in retail tobacco stores, tobacco warehouses, or tobacco manufacturing facilities.
		</section>
	</text>
	<history>2009, cc. 153, 154.</history>
</law>
