<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="III" level="2">Trusts</unit>
		<unit label="chapter" identifier="7" level="3">Uniform Trust Code</unit>
		<unit label="article" identifier="9" level="4">Uniform Prudent Investor Act</unit>
	</structure>
	<section_number>64.2-790</section_number>
	<catch_line>Application to existing trusts</catch_line>
	<text>
		This article applies to trusts existing on and created after January 1, 2000. As applied to trusts existing on its effective date, this article governs only decisions or actions occurring after that date.
	</text>
	<history>1999, c. 772, § 26-45.12; 2012, c. 614.</history>
</law>
