<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="26" level="2">Appeals to the Supreme Court</unit>
		<unit label="article" identifier="2" level="3">When Granted</unit>
	</structure>
	<section_number>8.01-670</section_number>
	<catch_line>In what cases awarded</catch_line>
	<text>
		A party aggrieved by a final decision of the Court of Appeals may petition the Supreme Court for an appeal in accordance with § 17.1-411.
	</text>
	<history>Code 1950, § 8-462; 1977, c. 617; 1984, c. 703; 1997, c. 801; 2002, c. 107; 2005, c. 681; 2021, Sp. Sess. I, c. 489.</history>
</law>
