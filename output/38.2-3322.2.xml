<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="38.2" level="1">Insurance</unit>
		<unit label="chapter" identifier="33" level="2">Life Insurance Policies</unit>
		<unit label="article" identifier="2" level="3">Group Life Insurance Policies</unit>
	</structure>
	<section_number>38.2-3322.2</section_number>
	<catch_line>Lives covered</catch_line>
	<text>
		A group life insurance policy shall cover at least two persons, other than spouses or minor children, at the issue date and at each policy anniversary date.
	</text>
	<history>1998, c. 154.</history>
</law>
