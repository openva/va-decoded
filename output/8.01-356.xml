<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="11" level="2">Juries</unit>
		<unit label="article" identifier="4" level="3">Jury Service</unit>
	</structure>
	<section_number>8.01-356</section_number>
	<catch_line>Failure of juror to appear</catch_line>
	<text>
		If any juror who has been given due notice to appear in court shall fail to do so without sufficient excuse, he shall be fined not less than $50 nor more than $200.
	</text>
	<history>Code 1950, § 8-208.18; 1973, c. 439; 1977, c. 617; 2004, c. 116.</history>
</law>
