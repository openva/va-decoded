	<section_number>1-250</section_number>
	<catch_line>Swear; sworn</catch_line>
	<text>
		"Swear" or "sworn" means "affirm" or "affirmed."
	</text>
	<history>Code 1919, § 5; Code 1950, § 1-13; 1950, p. 23, § 1-13.28; 2005, c. 839.</history>
