<law>
	<structure>
		<unit label="title" identifier="29.1" level="1">Wildlife, Inland Fisheries and Boating</unit>
		<unit label="chapter" identifier="8" level="2">Watercraft Dealer Licensing Act</unit>
		<unit label="article" identifier="2" level="3">Application, Issuance, Fees, Renewal, Revocation</unit>
	</structure>
	<section_number>29.1-817</section_number>
	<catch_line>Lists of licensed salesmen</catch_line>
	<text>
		Each dealer shall keep a current list of his licensed salesmen, showing names, addresses and serial numbers of their licenses, posted in a conspicuous place in each place of business.
	</text>
	<history>1988, c. 592.</history>
</law>
