	<section_number>23.1-2802</section_number>
	<catch_line>Powers and duties</catch_line>
	<text>
		<section prefix="A">The board shall generally direct the affairs of the university.
		</section>
		<section prefix="B">The board may confer degrees.
		</section>
	</text>
