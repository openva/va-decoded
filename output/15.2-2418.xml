<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="15.2" level="1">Counties, Cities and Towns</unit>
		<unit label="subtitle" identifier="II" level="2">Powers of Local Government</unit>
		<unit label="chapter" identifier="24.1" level="3">Urban Public-Private Partnership Redevelopment Fund</unit>
	</structure>
	<section_number>15.2-2418</section_number>
	<catch_line>Reports</catch_line>
	<text>
		On or before September 30 of each year, each local government recipient shall report to the Department on the status of all sites being prepared for redevelopment with the grant or loan.
	</text>
	<history>2000, c. 757; 2004, c. 577.</history>
</law>
