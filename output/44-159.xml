<law>
	<structure>
		<unit label="title" identifier="44" level="1">Military and Emergency Laws</unit>
		<unit label="chapter" identifier="5" level="2">Mobilization of Fire Fighters</unit>
	</structure>
	<section_number>44-159</section_number>
	<catch_line>When chapter in effect</catch_line>
	<text>
		This chapter shall be in effect only during the time a state of war exists between the United States and any foreign country.
	</text>
	<history>1942, p. 370; Michie Code 1942, § 2673(144).</history>
