<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="13.1" level="1">Corporations</unit>
		<unit label="chapter" identifier="11" level="2">Industrial Development Corporations</unit>
	</structure>
	<section_number>13.1-984</section_number>
	<catch_line>Corporate name</catch_line>
	<text>
		Every corporation created under this chapter shall have as part of its corporate name or title the words "Industrial Development."
	</text>
	<history>Code 1950, § 13.1-143; 1960, c. 80; 1985, c. 522.</history>
</law>
