<law>
	<structure>
		<unit label="title" identifier="64.2" level="1">Wills, Trusts, and Fiduciaries</unit>
		<unit label="subtitle" identifier="II" level="2">Wills and Decedents' Estates</unit>
		<unit label="chapter" identifier="5" level="3">Personal Representatives and Administration of Estates</unit>
		<unit label="article" identifier="3" level="4">Authority and General Duties</unit>
	</structure>
	<section_number>64.2-514</section_number>
	<catch_line>Duty of every personal representative</catch_line>
	<text>
		Every personal representative shall administer, well and truly, the whole personal estate of his decedent.
	</text>
	<history>Code 1950, § 64-131; 1968, c. 656, § 64.1-139; 2012, c. 614.</history>
</law>
