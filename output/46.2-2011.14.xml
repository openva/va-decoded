<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="20" level="3">Regulation of Passenger Carriers</unit>
		<unit label="article" identifier="1" level="4">Motor Carriers of Passengers -- Generally</unit>
	</structure>
	<section_number>46.2-2011.14</section_number>
	<catch_line>Notice of abandonment of service</catch_line>
	<text>
		Every motor carrier, TNC broker, broker, or excursion train operator who ceases operation or abandons his rights under a license, certificate, or permit issued shall notify the Department within 30 days of such cessation or abandonment.
	</text>
	<history>2001, c. 596; 2002, c. 861; 2017, c. 635.</history>
</law>
