<?xml version="1.0" encoding="utf-8"?>
<law>
	<structure>
		<unit label="title" identifier="46.2" level="1">Motor Vehicles</unit>
		<unit label="subtitle" identifier="V" level="2">Motor Carriers</unit>
		<unit label="chapter" identifier="21" level="3">Regulation of Property Carriers</unit>
		<unit label="article" identifier="1" level="4">Motor Carriers of Property -- Generally</unit>
	</structure>
	<section_number>46.2-2102</section_number>
	<catch_line>Compliance with chapter required</catch_line>
	<text>
		No motor carrier shall operate any motor vehicle for the transportation of property for compensation on any highway in this Commonwealth on an intrastate basis except in accordance with the provisions of this chapter.
	</text>
	<history>Code 1950, § 56-338.3; 1995, cc. 744, 803; 2001, c. 596.</history>
</law>
