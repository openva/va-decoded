<law>
	<structure>
		<unit label="title" identifier="8.01" level="1">Civil Remedies and Procedure</unit>
		<unit label="chapter" identifier="25" level="2">Extraordinary Writs</unit>
		<unit label="article" identifier="1" level="3">Writ of Quo Warranto</unit>
	</structure>
	<section_number>8.01-639</section_number>
	<catch_line>How summons directed and served</catch_line>
	<text>
		The writ and a copy of the petition attached thereto may be directed to the sheriff of any county or city and shall be served as in other actions.
	</text>
	<history>Code 1950, § 8-861; 1977, c. 617.</history>
</law>
